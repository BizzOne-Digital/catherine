# Database
MONGODB_URI=mongodb://127.0.0.1:27017/lumina-medi-spa

# Public site URL (Stripe redirects + product images)
# Production (required on Vercel): https://luminamedispa.ca
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (shop checkout) — add keys from https://dashboard.stripe.com/apikeys
# Local: use test keys. Webhook secret from `stripe listen` or Dashboard → Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: reuse a Stripe Tax Rate ID (otherwise app creates/reuses 13% HST automatically)
STRIPE_HST_TAX_RATE_ID=

# Admin auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL_LOGIN=
ADMIN_PASSWORD=

# Email (order confirmations + inquiry notifications)
SMTP_USER=Luminamedispa@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ADMIN_EMAIL=Luminamedispa@gmail.com

# Online booking — Google Calendar API (service account)
# Vercel: paste the FULL JSON key file as one line (keep \n inside private_key)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=luminamedispa@gmail.com
# Optional: extra calendar IDs to block (comma-separated) if appointments live on sub-calendars
GOOGLE_CALENDAR_IDS=
# Share luminamedispa@gmail.com with the service account — Make changes to events
# After deploy verify: https://luminamedispa.ca/api/booking/health

# Optional Phase 1 fallback (superseded by on-site booking at /book)
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=

# Optional Google reviews
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=
